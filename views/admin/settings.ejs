<%- include('../partials/admin-header') %>

<div class="page-head">
  <h1 class="page-title"><%= t('settings') %></h1>
</div>

<div class="grid-2">
  <form class="card" method="post" action="/admin/settings">
    <h3 class="card-title"><%= t('store_settings') %></h3>
    <div class="form-row">
      <label><%= t('store_name') %></label>
      <input type="text" name="store_name" value="<%= settings.store_name || '' %>">
    </div>
    <div class="form-row">
      <label><%= t('currency') %></label>
      <input type="text" name="store_currency" value="<%= settings.store_currency || '' %>" dir="ltr">
    </div>
    <div class="form-row two">
      <div>
        <label><%= t('shipping_fee') %></label>
        <input type="number" step="0.01" name="shipping_fee" value="<%= settings.shipping_fee || 0 %>" dir="ltr">
      </div>
      <div>
        <label><%= t('free_shipping_threshold') %></label>
        <input type="number" step="0.01" name="free_shipping_threshold" value="<%= settings.free_shipping_threshold || 0 %>" dir="ltr">
        <small class="muted">0 = <%= t('always_charge_shipping') %></small>
      </div>
    </div>
    <div class="form-row">
      <label><%= t('footer_note') %></label>
      <textarea name="footer_note" rows="2"><%= settings.footer_note || '' %></textarea>
    </div>
    <h3 class="card-title"><%= t('contact_info') %></h3>
    <div class="form-row two">
      <div>
        <label><%= t('phone') %></label>
        <input type="tel" name="contact_phone" value="<%= settings.contact_phone || '' %>" dir="ltr">
      </div>
      <div>
        <label><%= t('whatsapp') %></label>
        <input type="tel" name="contact_whatsapp" value="<%= settings.contact_whatsapp || '' %>" dir="ltr">
      </div>
    </div>
    <div class="form-row">
      <label><%= t('email') %></label>
      <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" dir="ltr">
    </div>
    <div class="form-row">
      <label><%= t('address') %></label>
      <textarea name="contact_address" rows="2"><%= settings.contact_address || '' %></textarea>
    </div>
    <button class="btn btn-primary" type="submit"><%= t('save_settings') %></button>
  </form>

  <form class="card" method="post" action="/admin/account/password">
    <h3 class="card-title"><%= t('change_password') %></h3>
    <p class="muted"><%= t('logged_in_as') %>: <strong><%= currentAdmin.username %></strong></p>
    <div class="form-row">
      <label><%= t('current_password') %></label>
      <input type="password" name="current" required>
    </div>
    <div class="form-row">
      <label><%= t('new_password') %></label>
      <input type="password" name="next" required minlength="6">
    </div>
    <button class="btn btn-primary" type="submit"><%= t('change_password') %></button>
  </form>
</div>

<!-- Notification settings (separate full-width card) -->
<form class="card notif-card" method="post" action="/admin/settings">
  <h3 class="card-title">🔔 <%= t('notifications_title') %></h3>
  <p class="muted"><%= t('notifications_intro') %></p>

  <div class="grid-2">
    <!-- Telegram -->
    <div class="notif-channel">
      <h4 class="notif-title">📨 Telegram</h4>
      <p class="muted small"><%= t('telegram_help') %></p>

      <div class="form-row">
        <label><%= t('telegram_bot_token') %></label>
        <input type="text" name="telegram_bot_token" dir="ltr"
               value="<%= settings.telegram_bot_token || '' %>"
               placeholder="123456789:ABCdefGHIjklMNOpqrsTUVwxyz">
        <small class="muted"><%= t('telegram_token_help') %></small>
      </div>
      <div class="form-row">
        <label><%= t('telegram_chat_id') %></label>
        <input type="text" name="telegram_chat_id" dir="ltr"
               value="<%= settings.telegram_chat_id || '' %>"
               placeholder="123456789">
        <small class="muted"><%= t('telegram_chat_help') %></small>
      </div>
      <button type="button" class="btn" data-test="telegram">🧪 <%= t('test_telegram') %></button>
      <span class="notif-result" id="result-telegram"></span>
    </div>

    <!-- WhatsApp via CallMeBot -->
    <div class="notif-channel">
      <h4 class="notif-title">💬 WhatsApp (CallMeBot)</h4>
      <p class="muted small"><%= t('whatsapp_help') %></p>

      <div class="form-row">
        <label><%= t('callmebot_phone') %></label>
        <input type="tel" name="callmebot_phone" dir="ltr"
               value="<%= settings.callmebot_phone || '' %>"
               placeholder="+212600000000">
        <small class="muted"><%= t('callmebot_phone_help') %></small>
      </div>
      <div class="form-row">
        <label><%= t('callmebot_api_key') %></label>
        <input type="text" name="callmebot_api_key" dir="ltr"
               value="<%= settings.callmebot_api_key || '' %>"
               placeholder="1234567">
        <small class="muted"><%= t('callmebot_key_help') %></small>
      </div>
      <button type="button" class="btn" data-test="whatsapp">🧪 <%= t('test_whatsapp') %></button>
      <span class="notif-result" id="result-whatsapp"></span>
    </div>
  </div>

  <div class="form-row" style="margin-top:16px;">
    <button class="btn btn-primary" type="submit">💾 <%= t('save_settings') %></button>
  </div>
</form>

<details class="card notif-help">
  <summary><strong>📖 <%= t('notifications_setup_guide') %></strong></summary>
  <div class="guide-body">
    <h4>📨 Telegram في 5 دقائق</h4>
    <ol>
      <li>افتح Telegram → ابحث عن <code>@BotFather</code></li>
      <li>أرسل: <code>/newbot</code></li>
      <li>اختر اسم (مثلاً: <code>MyStore Bot</code>) و username (مثلاً: <code>mystore_xyz_bot</code>)</li>
      <li>BotFather يعطيك <strong>Token</strong> — انسخه في الحقل أعلاه</li>
      <li>من Telegram، افتح محادثة مع البوت تبعك (username الذي اخترته) وأرسل <code>/start</code></li>
      <li>افتح هذا الرابط في المتصفح (ضع TOKEN مكان YOUR_TOKEN):
        <br><code>https://api.telegram.org/bot<strong>YOUR_TOKEN</strong>/getUpdates</code>
      </li>
      <li>في الـ JSON راح تشوف <code>"chat":{"id": <strong>123456789</strong>}</code> — هذا هو الـ <strong>Chat ID</strong></li>
      <li>انسخه في الحقل أعلاه واضغط "حفظ الإعدادات"</li>
    </ol>

    <h4>💬 WhatsApp (CallMeBot) في 3 دقائق</h4>
    <ol>
      <li>من تليفونك، أضف الرقم هذا في جهات الاتصال: <code>+34 644 71 81 99</code> (إسباني، اسمه CallMeBot)</li>
      <li>افتح WhatsApp وأرسل له: <code>I allow callmebot to send me messages</code></li>
      <li>انتظر دقيقة — راح يرد عليك بالـ <strong>API Key</strong></li>
      <li>انسخ الـ API Key + رقم تليفونك (مع رمز الدولة مثل <code>+212600000000</code>) في الحقول أعلاه</li>
    </ol>

    <p class="muted small">💡 ملاحظة: CallMeBot مجاني لكن محدود (~10 رسائل/ساعة). يكفي للبداية. لو زاد، استخدم Twilio أو Meta WhatsApp Business API.</p>
  </div>
</details>

<style>
  .notif-card { margin-top: 16px; }
  .notif-channel { background: var(--bg); border-radius: 8px; padding: 16px; }
  .notif-title { margin: 0 0 8px; font-size: 1.05rem; }
  .notif-result { display: inline-block; margin-inline-start: 8px; font-size: 0.9rem; }
  .notif-result.ok { color: #166534; }
  .notif-result.err { color: #991b1b; }
  .notif-help { margin-top: 16px; }
  .notif-help summary { cursor: pointer; padding: 8px 0; }
  .guide-body { padding-top: 12px; }
  .guide-body h4 { margin-top: 16px; }
  .guide-body code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 0.9rem; direction: ltr; display: inline-block; }
  .guide-body ol { padding-inline-start: 20px; }
  .guide-body li { margin-bottom: 6px; }
</style>

<script>
  (function () {
    // Test notification buttons
    document.querySelectorAll('[data-test]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const channel = btn.getAttribute('data-test');
        const resultEl = document.getElementById('result-' + channel);
        btn.disabled = true;
        const oldText = btn.textContent;
        btn.textContent = '⏳ ...';
        resultEl.className = 'notif-result';
        resultEl.textContent = '';

        fetch('/admin/notifications/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ channel }),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            btn.disabled = false;
            btn.textContent = oldText;
            if (d.ok) {
              resultEl.className = 'notif-result ok';
              resultEl.textContent = '✅ ' + (d.message || 'sent');
            } else {
              resultEl.className = 'notif-result err';
              resultEl.textContent = '❌ ' + (d.error || 'failed');
            }
          })
          .catch(function (e) {
            btn.disabled = false;
            btn.textContent = oldText;
            resultEl.className = 'notif-result err';
            resultEl.textContent = '❌ ' + e.message;
          });
      });
    });
  })();
</script>

<%- include('../partials/admin-footer') %>
