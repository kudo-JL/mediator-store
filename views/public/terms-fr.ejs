<%- include('../partials/header') %>

<style>
  .legal-page { max-width: 880px; margin: 0 auto; padding: 32px 16px 80px; }
  .legal-page h1 { font-size: 2rem; margin: 0 0 8px; }
  .legal-page .meta { opacity: .7; margin-bottom: 32px; font-size: .9rem; }
  .legal-page h2 { font-size: 1.4rem; margin: 32px 0 12px; padding-bottom: 6px; border-bottom: 1px solid rgba(0,0,0,.1); }
  .legal-page h3 { font-size: 1.1rem; margin: 20px 0 8px; }
  .legal-page p { line-height: 1.7; margin: 0 0 12px; }
  .legal-page ul, .legal-page ol { line-height: 1.7; padding-left: 24px; margin: 0 0 16px; }
  .legal-page li { margin-bottom: 6px; }
  .legal-page .info-box { background: rgba(37,99,235,.05); border-left: 3px solid #2563eb; padding: 16px; margin: 16px 0; border-radius: 4px; }
  .legal-page .last-updated { display: inline-block; padding: 4px 10px; background: rgba(0,0,0,.05); border-radius: 4px; font-size: .85rem; }
  .lang-switch { display: flex; gap: 8px; margin-bottom: 16px; font-size: .9rem; }
  .lang-switch a { padding: 4px 12px; border: 1px solid rgba(0,0,0,.1); border-radius: 4px; text-decoration: none; opacity: .7; }
  .lang-switch a.active { background: #2563eb; color: #fff; opacity: 1; border-color: #2563eb; }
</style>

