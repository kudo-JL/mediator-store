<%- include('../partials/header') %>

<section class="container section">
  <div class="success-card">
    <div class="success-icon">✓</div>
    <h1 class="success-title"><%= t('order_received') %></h1>
    <p class="muted"><%= t('order_number') %>: <strong><%= order.order_number %></strong></p>

    <div class="order-detail">
      <h3><%= t('order_summary') %></h3>
      <ul class="summary-list">
        <% items.forEach(function(it){ %>
          <li>
            <span class="sum-name"><%= it.product_name %> × <%= it.quantity %></span>
            <span class="sum-price"><%= fmtPrice(it.line_total) %></span>
          </li>
        <% }) %>
      </ul>
      <div class="summary-row"><span><%= t('subtotal') %></span><span><%= fmtPrice(order.subtotal) %></span></div>
      <div class="summary-row"><span><%= t('shipping') %></span><span><%= fmtPrice(order.shipping) %></span></div>
      <div class="summary-row total"><span><%= t('total') %></span><span><%= fmtPrice(order.total) %></span></div>
    </div>

    <h3><%= t('customer_info') %></h3>
    <ul class="kv">
      <li><strong><%= t('full_name') %>:</strong> <%= order.customer_name %></li>
      <li><strong><%= t('phone') %>:</strong> <%= order.customer_phone %></li>
      <% if (order.customer_email) { %><li><strong><%= t('email') %>:</strong> <%= order.customer_email %></li><% } %>
      <% if (order.customer_city) { %><li><strong><%= t('city') %>:</strong> <%= order.customer_city %></li><% } %>
      <% if (order.customer_address) { %><li><strong><%= t('address') %>:</strong> <%= order.customer_address %></li><% } %>
    </ul>

    <% if (site.contact.whatsapp) { %>
      <a class="btn btn-primary btn-lg" target="_blank" rel="noopener" href="https://wa.me/<%= site.contact.whatsapp.replace(/[^\d]/g,'') %>?text=<%= encodeURIComponent(t('whatsapp_order_msg', { num: order.order_number, total: order.total + ' ' + site.currency })) %>">
        💬 <%= t('confirm_via_whatsapp') %>
      </a>
    <% } %>

    <p><a href="/" class="btn btn-ghost"><%= t('back_home') %></a></p>
  </div>
</section>

<%- include('../partials/footer') %>
