<%- include('../partials/header') %>

<section class="container section">
  <h1 class="page-title"><%= t('cart') %></h1>
  <% if (cart.items.length === 0) { %>
    <div class="empty">
      <p><%= t('cart_empty') %></p>
      <a href="/" class="btn btn-primary"><%= t('continue_shopping') %></a>
    </div>
  <% } else { %>
    <div class="cart-wrap">
      <table class="cart-table">
        <thead>
          <tr>
            <th colspan="2"><%= t('product') %></th>
            <th><%= t('price') %></th>
            <th><%= t('quantity') %></th>
            <th><%= t('line_total') %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% cart.items.forEach(function(it){ %>
            <tr data-product-id="<%= it.product_id %>">
              <td class="ct-img">
                <% if (it.image_path) { %><img src="<%= it.image_path %>" alt=""><% } %>
              </td>
              <td><%= it.name %></td>
              <td><%= fmtPrice(it.unit_price) %></td>
              <td>
                <input type="number" class="cart-qty" value="<%= it.quantity %>" min="0" data-product-id="<%= it.product_id %>">
              </td>
              <td class="line-total"><%= fmtPrice(it.unit_price * it.quantity) %></td>
              <td>
                <button class="btn btn-ghost cart-remove" data-product-id="<%= it.product_id %>">✕</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" class="ar"><%= t('subtotal') %></td>
            <td colspan="2"><strong id="cart-subtotal"><%= fmtPrice(subtotal) %></strong></td>
          </tr>
        </tfoot>
      </table>
            <%# ---- Free-shipping progress (shows only when a threshold is configured) ---- %>
      <%
        const _fshipThr = parseFloat(site.free_shipping_threshold) || 0;
        const _fshipFee = parseFloat(site.shipping_fee) || 0;
        const _fshipAchieved = _fshipThr > 0 && subtotal >= _fshipThr;
        const _fshipRemaining = _fshipThr > 0 ? Math.max(0, _fshipThr - subtotal) : 0;
        const _fshipPct = _fshipThr > 0 ? Math.min(100, (subtotal / _fshipThr) * 100) : 0;
      %>
      <% if (_fshipThr > 0 && _fshipFee > 0) { %>
        <div class="fship-progress <%= _fshipAchieved ? 'fship-success' : '' %>">
          <p class="fship-progress-text">
            <% if (_fshipAchieved) { %>
              🎉 <strong><%= t('free_ship_congrats') || 'مبروك!' %></strong>
              <%= t('free_ship_you_qualify') || 'طلبك يستحق شحن مجاني' %>
            <% } else { %>
              🚚 <%= t('free_ship_add_more') || 'أضف' %>
              <strong><%= _fshipRemaining.toFixed(2) %> <%= site.currency || 'DH' %></strong>
              <%= t('free_ship_to_qualify') || 'للحصول على شحن مجاني' %>
            <% } %>
          </p>
          <div class="fship-bar" aria-hidden="true">
            <div class="fship-bar-fill" style="width: <%= _fshipPct.toFixed(1) %>%"></div>
          </div>
          <p class="fship-meta">
            <%= t('free_ship_threshold_label') || 'حد الشحن المجاني' %>:
            <strong><%= _fshipThr %> <%= site.currency || 'DH' %></strong>
            <span class="fship-meta-sep">·</span>
            <%= t('free_ship_fee_label') || 'رسوم الشحن' %>:
            <strong><%= _fshipFee %> <%= site.currency || 'DH' %></strong>
          </p>
        </div>
      <% } %>

      <div class="cart-actions">
        <a href="/" class="btn btn-ghost"><%= t('continue_shopping') %></a>
        <a href="/checkout" class="btn btn-primary btn-lg"><%= t('proceed_to_checkout') %></a>
      </div>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
