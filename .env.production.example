# .env.production.example
# Use this as a reference for what to set in Coolify's Environment Variables UI.
# DO NOT commit a real .env file. Set these values in Coolify (or your host's UI).

# --- Server ---
NODE_ENV=production
PORT=3000

# --- Session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-64-char-random-hex-string

# --- Admin ---
ADMIN_USERNAME=admin
# Use a strong password (at least 12 chars, mix of letters/numbers/symbols)
ADMIN_PASSWORD=change-me-before-going-live

# --- Store ---
STORE_NAME=متجر الوسيط
STORE_CURRENCY=د.م.
DEFAULT_LANGUAGE=ar

# --- Optional contact (set later in admin settings) ---
# STORE_PHONE=+212600000000
# STORE_WHATSAPP=+212600000000
# STORE_EMAIL=hello@example.com
# SHIPPING_FEE=30
# FREE_SHIPPING_THRESHOLD=500
